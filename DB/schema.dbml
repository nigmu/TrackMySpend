// Smart Finance Tracker — Database Schema
// Format: DBML (https://dbml.dbdiagram.io/docs)
// Database: SQLite
// Conventions:
//   - Datetimes stored as TEXT in ISO 8601 (YYYY-MM-DDTHH:MM:SS)
//   - Booleans stored as INTEGER (0/1)
//   - JSON arrays stored as TEXT
//   - Amounts always positive REAL; direction column carries 'debit'/'credit'
//   - PRAGMA foreign_keys = ON required at every connection


// ─────────────────────────────────────────
// AUTH & USER
// ─────────────────────────────────────────

Table app_settings {
  id          integer  [primary key, increment]
  key         text     [not null, unique, note: 'e.g. log_retention_days, default_currency, llm_model, anomaly_threshold_multiplier']
  value       text     [not null, note: 'Stored as string; cast in application layer']
  description text
  updated_at  text
}


// ─────────────────────────────────────────
// INGESTION
// ─────────────────────────────────────────

Table email_accounts {
  id                    integer  [primary key, increment]
  email_address         text     [not null, unique]
  oauth_access_token    text     [not null, note: 'Encrypted at rest']
  oauth_refresh_token   text     [not null, note: 'Encrypted at rest']
  polling_interval_min  integer  [default: 60]
  last_polled_at        text
  is_active             integer  [default: 1]
  created_at            text     [not null]
}

Table sms_sources {
  id             integer  [primary key, increment]
  email_account_id        integer  [not null]
  phone_number   text     [not null, unique]
  carrier        text     [note: 'e.g. Airtel, Jio']
  is_active      integer  [default: 1]
  last_parsed_at text
  created_at     text     [not null]
}

Table parse_jobs {
  id                     integer  [primary key, increment]
  email_account_id       integer  [note: 'Nullable; set for email source']
  sms_source_id          integer  [note: 'Nullable; set for SMS source']
  source_type            text     [not null, note: 'email | sms | import | backfill']
  status                 text     [not null, note: 'pending | running | success | failed']
  input_preview          text     [note: 'First 500 chars of raw input']
  llm_input              text     [note: 'Full prompt sent to LLM']
  llm_output             text     [note: 'Raw LLM response']
  transactions_extracted integer  [default: 0]
  error_message          text     [note: 'Populated on failure; surfaced in UI']
  started_at             text
  completed_at           text
}


// ─────────────────────────────────────────
// BANKING
// ─────────────────────────────────────────

Table bank_accounts {
  id                     integer  [primary key, increment]
  email_account_id                integer  [not null]
  display_name           text     [not null, note: 'e.g. HDFC Savings, Axis Credit Card']
  account_type           text     [not null, note: 'savings | current | credit_card | wallet']
  bank_name              text
  account_number_masked  text     [note: 'Last 4 digits only']
  credit_limit           real     [note: 'Credit cards only']
  billing_cycle_day      integer  [note: 'Credit cards: statement generation day of month']
  due_day                integer  [note: 'Credit cards: payment due day of month']
  current_balance        real     [note: 'Manually updated snapshot']
  balance_updated_at     text
  is_active              integer  [default: 1]
  created_at             text     [not null]
}

Table balance_snapshots {
  id              integer  [primary key, increment]
  bank_account_id integer  [not null]
  balance         real     [not null]
  snapshot_date   text     [not null, note: 'ISO date YYYY-MM-DD']
  source          text     [note: 'manual | auto']
  created_at      text     [not null]

  indexes {
    (bank_account_id, snapshot_date)
  }
}

Table credit_card_statements {
  id              integer  [primary key, increment]
  bank_account_id integer  [not null, note: 'Must be account_type = credit_card']
  statement_date  text     [not null]
  due_date        text     [not null]
  total_due       real     [not null]
  min_due         real
  paid_amount     real     [default: 0]
  paid_at         text
  status          text     [not null, note: 'unpaid | partial | paid | overdue']
  created_at      text     [not null]
}


// ─────────────────────────────────────────
// MERCHANTS & CATEGORIES
// ─────────────────────────────────────────

Table categories {
  id          integer  [primary key, increment]
  name        text     [not null, note: 'e.g. Food, Health, Salary']
  parent_id   integer  [note: 'Self-ref FK; NULL = top-level category']
  color       text     [note: 'Hex color string for UI']
  icon        text
  is_system   integer  [default: 0, note: '1 = pre-loaded default, 0 = user-created']
  is_active   integer  [default: 1, note: 'Soft-delete via 0']
  created_at  text     [not null]
}

Table merchants {
  id                  integer  [primary key, increment]
  display_name        text     [not null, note: 'e.g. Blinkit, Rohit Sharma']
  canonical_name      text     [note: 'Lowercased normalised form for deduplication']
  identifiers         text     [note: 'JSON array of UPI IDs, account numbers, VPAs']
  default_category_id integer
  alias               text     [note: 'User-given nickname']
  notes               text     [note: 'Free-text profile notes']
  is_verified         integer  [default: 0, note: '0 = auto-detected, 1 = manually confirmed']
  created_at          text     [not null]
  updated_at          text
}

Table tags {
  id         integer  [primary key, increment]
  name       text     [not null, unique, note: 'e.g. goa-trip, birthday-party']
  created_at text     [not null]
}


// ─────────────────────────────────────────
// TRANSACTIONS
// ─────────────────────────────────────────

Table transactions {
  id               integer  [primary key, increment]
  email_account_id          integer  [not null]
  bank_account_id  integer  [not null]
  merchant_id      integer  [note: 'Nullable; resolved by parser or manually']
  category_id      integer  [note: 'Nullable; overrides merchant default_category_id when set']
  income_source_id integer  [note: 'Nullable; set when credit matches an expected income']
  parse_job_id     integer  [note: 'Nullable; links to the ingestion job that created this row']
  amount           real     [not null, note: 'Always positive']
  direction        text     [not null, note: 'debit | credit']
  txn_type         text     [note: 'upi | neft | imps | rtgs | cash | emi | credit_card | transfer']
  description      text     [note: 'Raw text extracted from email or SMS']
  notes            text     [note: 'User-written annotation; LLM classifies into category']
  txn_date         text     [not null]
  value_date       text
  reference_number text     [note: 'Bank reference or UTR number']
  balance_after    real     [note: 'Account balance after this txn, from email']
  source           text     [not null, note: 'email | sms | manual | import']
  is_transfer      integer  [default: 0, note: '1 = between own accounts; excluded from P&L']
  is_deleted       integer  [default: 0]
  deleted_at       text
  created_at       text     [not null]
  updated_at       text

  indexes {
    (bank_account_id, txn_date)
    (merchant_id)
    (category_id)
    (direction, txn_date)
  }
}

Table transaction_tags {
  transaction_id  integer  [not null]
  tag_id          integer  [not null]

  indexes {
    (transaction_id, tag_id) [pk]
  }
}

Table transaction_attachments {
  id              integer  [primary key, increment]
  transaction_id  integer  [not null]
  file_path       text     [not null, note: 'Relative path on disk']
  file_type       text     [note: 'image | pdf | other']
  created_at      text     [not null]
}


// ─────────────────────────────────────────
// SPLITS
// ─────────────────────────────────────────

Table splits {
  id             integer  [primary key, increment]
  parent_txn_id  integer  [not null]
  total_amount   real     [not null, note: 'Full amount originally paid']
  user_share     real     [not null, note: 'total_amount minus sum of all participants owed_amount']
  notes          text
  status         text     [not null, note: 'open | partial | settled']
  created_at     text     [not null]
  updated_at     text
}

Table split_participants {
  id           integer  [primary key, increment]
  split_id     integer  [not null]
  person_name  text     [not null]
  merchant_id  integer  [note: 'Nullable; set if person has a known UPI ID in merchants']
  owed_amount  real     [not null]
  paid_amount  real     [default: 0]
  status       text     [not null, note: 'pending | partial | settled']
  created_at   text     [not null]
  updated_at   text
}

Table split_settlements {
  id                   integer  [primary key, increment]
  split_participant_id integer  [not null]
  transaction_id       integer  [not null, note: 'The incoming credit transaction']
  amount               real     [not null]
  settled_at           text     [not null]
  notes                text
}

Table split_reminders {
  id                   integer  [primary key, increment]
  split_participant_id integer  [not null]
  reminded_at          text     [not null]
  channel              text     [note: 'whatsapp_draft | text_draft | in_app']
  message_preview      text     [note: 'First 200 chars of the generated reminder message']
}


// ─────────────────────────────────────────
// INCOME & PLANNING
// ─────────────────────────────────────────

Table income_sources {
  id                integer  [primary key, increment]
  name              text     [not null, note: 'e.g. Primary salary, Freelance Client X']
  type              text     [not null, note: 'salary | freelance | rental | dividend | other']
  expected_amount   real
  bank_account_id   integer  [note: 'Nullable; which account receives this income']
  expected_day_type text     [note: 'last_working_day | fixed_date | manual']
  expected_date     integer  [note: 'Day of month if expected_day_type = fixed_date']
  is_active         integer  [default: 1]
  created_at        text     [not null]
}

Table salary_config {
  id               integer  [primary key, increment]
  income_source_id integer  [not null, unique]
  working_days     text     [note: 'JSON array e.g. [1,2,3,4,5] = Mon to Fri']
  last_day_override text    [note: 'Manual override for next pay date only']
  updated_at       text
}

Table holidays {
  id         integer  [primary key, increment]
  date       text     [not null, unique, note: 'YYYY-MM-DD']
  name       text     [not null, note: 'e.g. Diwali, Republic Day']
  created_at text     [not null]
}

Table budgets {
  id                  integer  [primary key, increment]
  category_id         integer  [not null]
  period_type         text     [not null, note: 'monthly | quarterly | yearly']
  amount              real     [not null]
  alert_threshold_pct integer  [default: 80]
  is_active           integer  [default: 1]
  created_at          text     [not null]
  updated_at          text
}

Table recurring_transactions {
  id                   integer  [primary key, increment]
  merchant_id          integer
  category_id          integer
  label                text     [note: 'e.g. Netflix subscription, Home loan EMI']
  expected_amount      real
  amount_tolerance_pct integer  [default: 5]
  frequency            text     [not null, note: 'weekly | monthly | quarterly | yearly']
  expected_day         integer  [note: 'Day of month the charge typically appears']
  last_seen_at         text
  next_expected_at     text
  auto_detected        integer  [default: 1, note: '1 = system found it, 0 = user-added']
  is_active            integer  [default: 1]
  created_at           text     [not null]
}

Table planned_expenses {
  id            integer  [primary key, increment]
  title         text     [not null, note: 'e.g. New laptop']
  amount        real     [not null]
  expected_date text
  category_id   integer
  notes         text
  is_fulfilled  integer  [default: 0]
  linked_txn_id integer  [note: 'Nullable; set when actual purchase transaction is recorded']
  created_at    text     [not null]
}


// ─────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────

Table notifications {
  id           integer  [primary key, increment]
  type         text     [not null, note: 'budget_alert | salary_not_received | cc_due_soon | cc_overdue | anomaly | recurring_missed | parse_failure']
  title        text     [not null]
  body         text
  entity_type  text     [note: 'Polymorphic: e.g. budget, bank_account, transaction']
  entity_id    integer  [note: 'Polymorphic FK to the related row']
  is_read      integer  [default: 0]
  is_dismissed integer  [default: 0]
  created_at   text     [not null]
  read_at      text
  dismissed_at text
}


// ─────────────────────────────────────────
// LOGS
// ─────────────────────────────────────────

Table system_logs {
  id          integer  [primary key, increment]
  level       text     [not null, note: 'info | warn | error | debug']
  action_type text     [not null, note: 'e.g. LOGIN, LOGOUT, PARSE_EMAIL_START, CREATE_TXN, UPDATE_TXN, DELETE_TXN, CREATE_SPLIT, BUDGET_ALERT_FIRED']
  entity_type text     [note: 'Polymorphic: e.g. transaction, merchant, split']
  entity_id   integer  [note: 'Polymorphic FK to affected row']
  old_value   text     [note: 'JSON snapshot of row before change']
  new_value   text     [note: 'JSON snapshot of row after change']
  ip_address  text
  user_agent  text
  created_at  text     [not null]

  indexes {
    (action_type, created_at)
    (entity_type, entity_id)
  }
}


// ─────────────────────────────────────────
// REFERENCES
// ─────────────────────────────────────────

// Auth
Ref: sms_sources.email_account_id > email_accounts.id
Ref: bank_accounts.email_account_id > email_accounts.id

// Ingestion
Ref: parse_jobs.email_account_id > email_accounts.id
Ref: parse_jobs.sms_source_id > sms_sources.id

// Banking
Ref: balance_snapshots.bank_account_id > bank_accounts.id
Ref: credit_card_statements.bank_account_id > bank_accounts.id

// Categories (self-referential)
Ref: categories.parent_id > categories.id

// Merchants
Ref: merchants.default_category_id > categories.id

// Transactions
Ref: transactions.email_account_id > email_accounts.id
Ref: transactions.bank_account_id > bank_accounts.id
Ref: transactions.merchant_id > merchants.id
Ref: transactions.category_id > categories.id
Ref: transactions.income_source_id > income_sources.id
Ref: transactions.parse_job_id > parse_jobs.id

// Transaction tags & attachments
Ref: transaction_tags.transaction_id > transactions.id
Ref: transaction_tags.tag_id > tags.id
Ref: transaction_attachments.transaction_id > transactions.id

// Splits
Ref: splits.parent_txn_id > transactions.id
Ref: split_participants.split_id > splits.id
Ref: split_participants.merchant_id > merchants.id
Ref: split_settlements.split_participant_id > split_participants.id
Ref: split_settlements.transaction_id > transactions.id
Ref: split_reminders.split_participant_id > split_participants.id

// Income & planning
Ref: income_sources.bank_account_id > bank_accounts.id
Ref: salary_config.income_source_id - income_sources.id  // one-to-one
Ref: budgets.category_id > categories.id
Ref: recurring_transactions.merchant_id > merchants.id
Ref: recurring_transactions.category_id > categories.id
Ref: planned_expenses.category_id > categories.id
Ref: planned_expenses.linked_txn_id > transactions.id
