// TrackMySpend — Database Schema
// Format: DBML (https://dbml.dbdiagram.io/docs)
// Database: PostgreSQL
//
// Relationships:
//   user_email_accounts.id → email_raw_ingest.email_account_id
//   email_raw_ingest.id → email_parse_queue.raw_ingest_id
//   email_parse_queue.id → transactions.parse_queue_id
//
// Conventions:
//   - OAuth tokens are application-encrypted; store as TEXT.
//   - gmail_message_id is the Gmail API string id (not numeric).
//   - Lifecycle columns use etl_status (PENDING / DONE / SKIPPED / PARSED).

Table user_email_accounts {
  id                     integer   [primary key, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  email_address          text      [not null, unique]
  oauth_access_token     text      [not null, note: 'Encrypted at rest']
  oauth_refresh_token    text      [not null, note: 'Encrypted at rest']
  polling_interval_min   integer   [not null, default: 60]
  last_polled_at         timestamptz
  is_active              boolean   [not null, default: true]
  last_history_id        bigint
  etl_insert_ts          timestamptz [not null, default: `now()`]
  etl_update_ts          timestamptz [not null, default: `now()`]
}

Table email_raw_ingest {
  id                      bigint    [primary key, increment]
  email_account_id        integer   [not null, note: 'FK → user_email_accounts.id']
  gmail_message_id        text      [not null, unique]
  gmail_thread_id         text
  sender_header           text
  subject                 text
  email_sent_at           timestamptz
  gmail_received_at       timestamptz
  gmail_internal_epoch_ms bigint
  snippet                 text
  raw_payload_json        jsonb
  etl_status              text      [not null, default: 'PENDING']
  etl_insert_ts           timestamptz [not null, default: `now()`]
  etl_update_ts           timestamptz [not null, default: `now()`]

  indexes {
    (etl_status, id)
  }
}

Table email_parse_queue {
  id                       bigint    [primary key, increment]
  raw_ingest_id            bigint    [not null, unique, note: 'FK → email_raw_ingest.id']
  email_account_id         integer   [not null, note: 'FK → user_email_accounts.id']
  sender_header            text
  subject                  text
  email_sent_at            timestamptz
  gmail_received_at        timestamptz
  gmail_internal_epoch_ms  bigint
  snippet                  text
  matched_pattern          text      [not null]
  etl_status               text      [not null, default: 'PENDING']
  etl_insert_ts            timestamptz [not null, default: `now()`]
  etl_update_ts            timestamptz [not null, default: `now()`]

  indexes {
    (etl_status, id)
  }
}

Table transactions {
  id                 bigint      [primary key, increment]
  parse_queue_id     bigint      [not null, note: 'FK → email_parse_queue.id']
  transaction_type   varchar(20) [not null]
  amount             bigint      [not null, note: 'Stored in paisa (1 INR = 100 paisa)']
  transaction_ts     timestamptz
  bank               varchar(20) [note: 'Issuing bank, e.g. HDFC']
  instrument         varchar(20) [note: 'bank_account / credit_card']
  channel            varchar(20) [note: 'upi / neft / rtgs / imps / debit_card / credit_card / nach / emi / cash / atm']
  account_last4      varchar(4)  [note: 'Last 4 digits of our card or account']
  counterparty       text        [note: 'Merchant / person / service name']
  counterparty_vpa   text        [note: 'UPI VPA or counterparty account reference']
  reference_number   text        [note: 'UPI ref / UTR / NACH mandate ID']
  extras             jsonb       [note: 'Type-specific extras: balance, threshold, frequency, installment details, location, etc.']
  etl_insert_ts      timestamptz [not null, default: `now()`]
  etl_update_ts      timestamptz [not null, default: `now()`]
}

Table filter_keywords {
  id            integer   [primary key, increment]
  keyword       text      [not null, unique]
  etl_insert_ts timestamptz [not null, default: `now()`]
}

Ref: email_raw_ingest.email_account_id > user_email_accounts.id
Ref: email_parse_queue.raw_ingest_id > email_raw_ingest.id
Ref: email_parse_queue.email_account_id > user_email_accounts.id
Ref: transactions.parse_queue_id > email_parse_queue.id
