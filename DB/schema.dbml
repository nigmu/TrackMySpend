// TrackMySpend — Database Schema
// Format: DBML (https://dbml.dbdiagram.io/docs)
// Database: PostgreSQL
//
// Relationships:
//   email_accounts.id → email_ingest_staging.email_account_id
//   email_ingest_staging.id → email_parse_queue_staging.stg1_id
//   email_parse_queue_staging.id → transactions.stg2_id
//
// Conventions:
//   - Timestamps from the app remain ISO 8601 text where columns were historically TEXT.
//   - OAuth tokens are application-encrypted; store as TEXT.
//   - gmail_message_id is the Gmail API string id (not numeric).

Table email_accounts {
  id                    integer  [primary key, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  email_address         text     [not null, unique]
  oauth_access_token    text     [not null, note: 'Encrypted at rest']
  oauth_refresh_token   text     [not null, note: 'Encrypted at rest']
  polling_interval_min  integer  [not null, default: 60]
  last_polled_at        text
  is_active             boolean  [not null, default: true]
  created_at            text     [not null]
  last_history_id       text
}

Table email_ingest_staging {
  id                    integer  [primary key, increment]
  email_account_id      integer  [not null, note: 'FK → email_accounts.id']
  email_address         text     [not null]
  gmail_message_id      text     [not null]
  thread_id             text
  from_header           text
  to_header             text
  subject               text
  date_header           text
  internal_date_ms      text
  gmail_received_at_utc text
  date_header_iso       text
  snippet               text
  fetched_at            text     [not null]
  raw_json              text
  stage2_status         text

  indexes {
    (email_account_id, gmail_message_id) [unique]
    (email_account_id, fetched_at)
    (stage2_status, id)
  }
}

Table email_parse_queue_staging {
  id                    integer  [primary key, increment]
  stg1_id               integer  [not null, note: 'FK → email_ingest_staging.id']
  email_account_id      integer  [not null, note: 'FK → email_accounts.id']
  email_address         text     [not null]
  gmail_message_id      text     [not null]
  thread_id             text
  from_header           text
  to_header             text
  subject               text
  date_header           text
  internal_date_ms      text
  gmail_received_at_utc text
  date_header_iso       text
  snippet               text
  matched_pattern       text     [not null]
  fetched_at            text     [not null]
  matched_at            text     [not null]
  raw_json              text
  parse_status          text

  indexes {
    (email_account_id, gmail_message_id) [unique]
    (email_account_id, matched_at)
  }
}

Table transactions {
  id                 integer   [primary key, increment]
  stg2_id            integer   [not null, note: 'FK → email_parse_queue_staging.id']
  email_account_id   integer   [not null, note: 'FK → email_accounts.id']
  gmail_message_id   text      [not null, note: 'Gmail API message id string']
  parsed_at          bigint    [not null, note: 'Unix epoch milliseconds']
  bank               text
  txn_type           text
  type               text
  instrument         text
  channel            text
  amount             decimal
  account            integer
  counterparty       text
  counterparty_vpa   text
  reference_number   text
  created_at         text      [not null]
  updated_at         text
}

// ── Foreign keys (explicit for DBML diagrams)
Ref: email_ingest_staging.email_account_id > email_accounts.id
Ref: email_parse_queue_staging.stg1_id > email_ingest_staging.id
Ref: transactions.stg2_id > email_parse_queue_staging.id