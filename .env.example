DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/trackmyspend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false
# Required when the API is reachable from the internet (Cloudflare tunnel).
SMS_INGEST_TOKEN=

# Fallback only: used when API_PUBLIC_BASE / FRONTEND_ORIGIN are unset.
# Host only — no scheme, no port. Derives http://<host>:2006 and :2007.
PUBLIC_HOST=localhost

# Primary public URLs (Cloudflare). Google OAuth redirect is
# {API_PUBLIC_BASE}/auth/gmail/callback
API_PUBLIC_BASE=http://localhost:2006
FRONTEND_ORIGIN=http://localhost:2007

# Extra UI origins that may call the API (localhost is already allowed).
# Add LAN and Tailscale UI origins here, comma-separated:
# http://<lan-host>:2007,http://<tailscale-host>:2007
CORS_EXTRA_ORIGINS=http://localhost:2007
